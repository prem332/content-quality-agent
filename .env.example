# Model provider
# NOTE: gemini-2.5-flash is blocked for newly created free-tier API keys
# ("no longer available to new users", confirmed via API). gemini-flash-latest
# is Google's current-recommended flash-tier alias and is what actually works
# on a fresh Google AI Studio key.
GENERATOR_MODEL=gemini-flash-latest
EVALUATOR_MODEL=gemini-flash-latest
GOOGLE_API_KEY=your_gemini_api_key_here

# Token limits
GENERATOR_MAX_TOKENS=2500
EVALUATOR_MAX_TOKENS=2200
MEMORY_MAX_TOKENS=400

# Retrieval / chunking
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
TOP_K=4

# Retry / rubric
MAX_RETRIES=2
RUBRIC_VERSION=v2

# LangSmith (optional — scaffolded from the start since it's free to add.
# See CLAUDE.md build order: reliance on this is capped and droppable.)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=content-quality-agent

# Demo mode (for the Loom deliberate-failure demonstration)
# Options: off | accuracy_failure | jargon_failure
DEMO_MODE=off
