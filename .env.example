# Model provider
# NOTE: gemini-2.5-flash is blocked for newly created free-tier API keys
# ("no longer available to new users", confirmed via API). gemini-flash-latest
# works but its underlying model (gemini-3.6-flash at time of writing) has a
# 20 requests/day free-tier quota -- easy to exhaust across a generate-
# evaluate-retry loop. gemini-flash-lite-latest is a separate model with its
# own quota pool and is what this project actually runs on; switch back to
# gemini-flash-latest if/when a higher-quota key is available.
GENERATOR_MODEL=gemini-flash-lite-latest
EVALUATOR_MODEL=gemini-flash-lite-latest
GOOGLE_API_KEY=your_gemini_api_key_here

# Token limits
# GENERATOR_MAX_TOKENS=6000, not the originally planned 2500 -- thinking
# tokens share this budget and a real lesson + its thinking overhead
# reliably needs 3200-5400 tokens total (see app/config.py for details).
GENERATOR_MAX_TOKENS=6000
EVALUATOR_MAX_TOKENS=2200
MEMORY_MAX_TOKENS=400

# gemini-flash-latest can't disable thinking, and thinking tokens count
# against max_output_tokens -- this is a soft hint that reduces (but does
# not hard-cap) thinking consumption (see app/config.py for details).
THINKING_BUDGET_TOKENS=500

# Retrieval / chunking
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50
TOP_K=4

# Retry / rubric
MAX_RETRIES=2
RUBRIC_VERSION=v2

# LangSmith (optional — scaffolded from the start since it's free to add.
# See CLAUDE.md build order: reliance on this is capped and droppable.)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=content-quality-agent

# Demo mode (for the Loom deliberate-failure demonstration)
# Options: off | accuracy_failure | jargon_failure
# accuracy_failure is the verified-reliable choice for recording -- it
# reliably fails C1 (+ C6 cascade) then ships clean on retry.
# jargon_failure exists but proved unreliable in testing: the generator's
# own "explain everything" system prompt kept adding an unprompted
# explanatory section that neutralized the injected defect. See README.
DEMO_MODE=off
